{
  "annotations": {
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "依條件計數照片，回傳整數與計數口徑（tag／semantic／face）。",
  "inputSchema": {
    "$defs": {
      "FolderRef": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "相對路徑，例 2024/Japan；禁止 .. 與絕對路徑",
            "maxLength": 500,
            "type": "string"
          },
          "source": {
            "description": "list_folders 回傳的 source alias",
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "PhotoFilters": {
        "additionalProperties": false,
        "properties": {
          "camera": {
            "maxLength": 100,
            "type": "string"
          },
          "categories": {
            "items": {
              "maxLength": 100,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "duplicates": {
            "default": "collapse",
            "enum": [
              "include",
              "collapse",
              "only"
            ]
          },
          "favorite": {
            "type": "boolean"
          },
          "folders": {
            "items": {
              "$ref": "#/$defs/FolderRef"
            },
            "maxItems": 20,
            "type": "array"
          },
          "media_kind": {
            "default": "any",
            "enum": [
              "photo",
              "screenshot",
              "raw",
              "any"
            ]
          },
          "min_confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "min_megapixels": {
            "maximum": 1000,
            "minimum": 0,
            "type": "number"
          },
          "month_day": {
            "description": "MM-DD：每年的這一天（本地時間）",
            "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
            "type": "string"
          },
          "orientation": {
            "enum": [
              "landscape",
              "portrait",
              "square"
            ]
          },
          "persons_all": {
            "description": "需要 faces:read",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "persons_any": {
            "description": "需要 faces:read",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "persons_none": {
            "description": "需要 faces:read",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "place": {
            "additionalProperties": false,
            "properties": {
              "admin1": {
                "maxLength": 100,
                "type": "string"
              },
              "city": {
                "maxLength": 100,
                "type": "string"
              },
              "country_code": {
                "description": "ISO 3166-1 alpha-2",
                "pattern": "^[A-Z]{2}$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "rating_min": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "review_state": {
            "enum": [
              "any",
              "pending",
              "approved",
              "corrected"
            ]
          },
          "tags_all": {
            "items": {
              "maxLength": 100,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "tags_any": {
            "items": {
              "maxLength": 100,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "tags_none": {
            "items": {
              "maxLength": 100,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "taken_at": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "description": "含當日，workspace 時區",
                "format": "date",
                "type": "string"
              },
              "to": {
                "description": "不含當日",
                "format": "date",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "filters": {
        "$ref": "#/$defs/PhotoFilters"
      },
      "query": {
        "maxLength": 500,
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "count_photos",
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "basis": {
        "enum": [
          "tag",
          "semantic",
          "face",
          "filter"
        ]
      },
      "count": {
        "type": "integer"
      }
    },
    "type": "object"
  },
  "title": "計數照片"
}
