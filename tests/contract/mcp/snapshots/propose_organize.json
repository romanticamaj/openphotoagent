{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "依條件把照片 copy/move/symlink/trash 到輸出資料夾，或寫 XMP sidecar。只會產生預覽計畫，不會改動任何檔案。套用需另呼叫 apply_organize，並由使用者在 app 內核准。建議優先使用 copy。",
  "inputSchema": {
    "$defs": {
      "FolderRef": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "description": "相對路徑，例 2024/Japan；禁止 .. 與絕對路徑",
            "maxLength": 500,
            "type": "string"
          },
          "source": {
            "description": "list_folders 回傳的 source alias",
            "maxLength": 100,
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "type": "object"
      },
      "PhotoFilters": {
        "additionalProperties": false,
        "properties": {
          "camera": {
            "maxLength": 100,
            "type": "string"
          },
          "categories": {
            "items": {
              "maxLength": 100,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "duplicates": {
            "default": "collapse",
            "enum": [
              "include",
              "collapse",
              "only"
            ]
          },
          "favorite": {
            "type": "boolean"
          },
          "folders": {
            "items": {
              "$ref": "#/$defs/FolderRef"
            },
            "maxItems": 20,
            "type": "array"
          },
          "media_kind": {
            "default": "any",
            "enum": [
              "photo",
              "screenshot",
              "raw",
              "any"
            ]
          },
          "min_confidence": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "min_megapixels": {
            "maximum": 1000,
            "minimum": 0,
            "type": "number"
          },
          "orientation": {
            "enum": [
              "landscape",
              "portrait",
              "square"
            ]
          },
          "persons_all": {
            "description": "需要 faces:read",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "persons_any": {
            "description": "需要 faces:read",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "persons_none": {
            "description": "需要 faces:read",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 5,
            "type": "array"
          },
          "place": {
            "additionalProperties": false,
            "properties": {
              "admin1": {
                "maxLength": 100,
                "type": "string"
              },
              "city": {
                "maxLength": 100,
                "type": "string"
              },
              "country_code": {
                "description": "ISO 3166-1 alpha-2",
                "pattern": "^[A-Z]{2}$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "rating_min": {
            "maximum": 5,
            "minimum": 0,
            "type": "integer"
          },
          "review_state": {
            "enum": [
              "any",
              "pending",
              "approved",
              "corrected"
            ]
          },
          "tags_all": {
            "items": {
              "maxLength": 100,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "tags_any": {
            "items": {
              "maxLength": 100,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "tags_none": {
            "items": {
              "maxLength": 100,
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "taken_at": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "description": "含當日，workspace 時區",
                "format": "date",
                "type": "string"
              },
              "to": {
                "description": "不含當日",
                "format": "date",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "copy",
          "move",
          "symlink",
          "hardlink",
          "trash",
          "sidecar_xmp",
          "sidecar_json"
        ]
      },
      "conflict_policy": {
        "default": "rename",
        "enum": [
          "skip",
          "rename",
          "overwrite_if_same_hash",
          "fail"
        ]
      },
      "path_template": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "scope": {
        "additionalProperties": false,
        "maxProperties": 1,
        "minProperties": 1,
        "properties": {
          "filters": {
            "$ref": "#/$defs/PhotoFilters"
          },
          "photo_ids": {
            "items": {
              "maxLength": 64,
              "type": "string"
            },
            "maxItems": 1000,
            "minItems": 1,
            "type": "array"
          },
          "selection_id": {
            "maxLength": 2048,
            "type": "string"
          }
        },
        "type": "object"
      },
      "target": {
        "$ref": "#/$defs/FolderRef"
      }
    },
    "required": [
      "scope",
      "action",
      "target",
      "path_template"
    ],
    "type": "object"
  },
  "name": "propose_organize",
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "approval_required": {
        "const": true
      },
      "conflicts": {
        "type": "integer"
      },
      "estimate": {
        "type": "object"
      },
      "plan_id": {
        "type": "string"
      },
      "plan_uri": {
        "type": "string"
      },
      "sample_actions": {
        "items": {
          "type": "object"
        },
        "maxItems": 20,
        "type": "array"
      },
      "summary": {
        "type": "object"
      }
    },
    "required": [
      "plan_id",
      "approval_required"
    ],
    "type": "object"
  },
  "title": "產生整理計畫（dry-run）"
}
